{%- layout none -%}
<!doctype html>
<html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Carte cadeau — {{ shop.name }}</title>{{ content_for_header }}</head>
<body style="margin:0;min-height:100vh;display:grid;place-items:center;font:500 15px/1.5 system-ui,sans-serif;background:#f4f1ea;color:#12100e;text-align:center">
<main style="padding:24px">
<p style="letter-spacing:.2em;text-transform:uppercase;font-size:12px">{{ shop.name }}</p>
<h1 style="margin:8px 0">{{ gift_card.balance | money }}</h1>
<p>Code : <strong>{{ gift_card.code | format_code }}</strong></p>
{%- if gift_card.expired %}<p>Cette carte a expiré.</p>{% endif -%}
</main></body></html>
